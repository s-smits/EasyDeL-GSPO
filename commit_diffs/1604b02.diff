-
-class GSPOTrainer(GRPOTrainer):
-    arguments: GSPOConfig  # type hinting
-
-    def __init__(
-        self,
-        arguments: GSPOConfig,
-        model: EasyDeLBaseModule | EasyDeLState | None,
