+def _project_to_capped_simplex(v, k):
+    """
+    Euclidean projection of v onto {w in [0,1]^G : sum w = k}.
+    Works on 1D numpy arrays; O(G log G).
+    """
+    import numpy as _np
+    v = _np.asarray(v, dtype=_np.float32)
+    G = v.size
+    # Clamp to [0,1] box via dual bisection on tau so that sum = k after clipping
+    lo, hi = -1e3, 1e3
+    for _ in range(40):
+        tau = 0.5 * (lo + hi)
+        w = _np.clip(v - tau, 0.0, 1.0)
+        s = w.sum()
+        if s > k:  # need smaller w ⇒ increase tau
+            lo = tau
+        else:
+            hi = tau
+    return _np.clip(v - 0.5 * (lo + hi), 0.0, 1.0)
 
