+mode = getattr(state, "importance_weight_normalization", "mean")  # or pass via arguments
+if mode == "mean":
+    w = w / jnp.maximum(jnp.mean(w, axis=1, keepdims=True), 1e-8)
+elif mode == "ess":
+    s1 = jnp.sum(w, axis=1, keepdims=True)
+    s2 = jnp.sum(w**2, axis=1, keepdims=True)
+    ess = (s1 * s1) / jnp.maximum(s2, 1e-8)  # in [1, G]
+    scale = jnp.sqrt(ess / G)
+    w = (w / jnp.maximum(jnp.mean(w, axis=1, keepdims=True), 1e-8)) * scale
