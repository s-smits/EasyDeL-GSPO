+def on_step_end(self, state, metrics, step):
+    state, metrics = super().on_step_end(state, metrics, step)
+    try:
+        clipped = float(metrics.get("clipped_fraction", 0.0))
+        mean_ratio = float(metrics.get("mean_ratio", 1.0))
+        # Optional: cache per-group weights from last step to compute ESS (not shown)
+        tau_clip = float(getattr(self.arguments, "gfpo_metric_switch_clip", 0.35))
+        cur = self.arguments.gfpo_metric
+        want_length = (clipped > tau_clip)
+        # Simple hysteresis
+        if want_length and cur != "length":
+            self.arguments.gfpo_metric = "length"
+        elif (clipped < 0.20) and cur != "token_efficiency":
+            self.arguments.gfpo_metric = "token_efficiency"
+    except Exception:
+        pass
+    return state, metrics
