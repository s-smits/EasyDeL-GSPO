+  --save_steps 100 \
+  --do_eval false \
+  --gradient_accumulation_steps 1 \
+  --beta 0.04 \
+  --temperature 0.7 \
+  --top_p 0.95 \
+  --top_k 50 \
+  --advantage_epsilon 1e-6 \
+  --sync_ref_model true \
+  --ref_model_sync_steps 1 \
+  --sync_ref_model_on_step_start true \
+  --ref_model_sync_strategy "hard" \
+  --ref_sync_copy_graphother true \
